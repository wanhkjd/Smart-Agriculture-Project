<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.suoduan.mapper.CategoryMapper">

    <select id="findAll" resultType="com.suoduan.entity.Category">
        SELECT id, name, type FROM category ORDER BY type, id
    </select>

    <select id="findByType" resultType="com.suoduan.entity.Category">
        SELECT id, name, type FROM category WHERE type = #{type} ORDER BY id
    </select>

</mapper>
